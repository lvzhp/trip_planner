#!/bin/sh
# 推送前的最后一道闸：被推送的每个 ref 的树里都不允许出现 .env / *.md。
banned='(^|/)\.env($|\.)|\.env$|\.md$'

status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  case "$local_sha" in
    0000000000000000000000000000000000000000) continue ;;
  esac
  hits=$(git ls-tree -r --name-only "$local_sha" 2>/dev/null | grep -Ei "$banned" || true)
  if [ -n "$hits" ]; then
    echo "✖ 推送被拒绝：$local_ref 的树里含 env / markdown 文件 →" >&2
    printf '%s\n' "$hits" | sed 's/^/    - /' >&2
    status=1
  fi
done

[ "$status" -eq 0 ] || exit 1
exit 0
